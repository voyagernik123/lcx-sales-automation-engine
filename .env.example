# LCX Sales Automation Engine — root env template
# Copy values into apps/*/.env for local development.
#
# Production deploy: set these via platform secrets dashboard
# (Cloudflare Pages / Fly / Railway / Cloud Run)

# ── Web (Vite SPA) ──
VITE_APP_TITLE=LCX Sales Automation Engine
# Production: set to API origin e.g. https://api.lcx-sales.example.com
VITE_API_URL=
# Must match apps/api OPERATOR_API_KEY
VITE_API_KEY=dev-operator-key-change-me

# ── API Server ──
PORT=8787
HOST=0.0.0.0
NODE_ENV=development  # switch to "production" for deployed environments

# ── Database ──
# Production: use a managed Postgres (Aiven / Neon / RDS / Supabase)
DATABASE_URL=postgresql://lcx:lcx_dev_password@localhost:5432/lcx_sales
# Set true only if intentionally running without Postgres
ALLOW_DB_SKIP=false

# ── Auth ──
# Production: generate a strong random key:
#   openssl rand -hex 32
OPERATOR_API_KEY=dev-operator-key-change-me

# ── CORS ──
# Production: list only your web app origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://lcx-sales-automation-engine.pages.dev

# ── External Services (optional until needed) ──
COINGECKO_API_KEY=
RESEND_API_KEY=
PHANTOMBUSTER_API_KEY=
