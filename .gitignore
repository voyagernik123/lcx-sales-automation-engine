# Playwright output. These were TRACKED, which made every local `npm run e2e` produce a
# spurious diff: index.html is a 560KB self-contained report that is rewritten in full on
# every run, and test-results/ carries per-failure context that becomes a phantom deletion
# the moment a test starts passing. Both are pure churn in `git status`, and churn is what
# trains you to stop reading it — the same reflex that let a 90-path working tree hide four
# streams of real work. CI already publishes the report through actions/upload-artifact, so
# nothing is lost by not tracking it.
playwright-report/
test-results/

# Research / local scratch
LCX USA.pdf
scratch_search_pdf.py
scratch_pdf_*.txt

# Postgres local volume noise (compose named volume preferred)
.pgdata/

# Seed data with PII — not committed
data/seeds/*.csv
data/seeds/*.xlsx

# LCXOS
# The updater signing PRIVATE key lives outside the repo (~/.lcx-terminal/) and
# must never be committed — it is the only thing standing between an operator's
# machine and a forged auto-update. Only the public key is in tauri.conf.json.
*.key
updater.key*
# Belt-and-braces: Rust build output (also ignored in apps/desktop/src-tauri).
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# Derived: rebuild with `node docs/3d/p1/build.mjs`. Committing it would let the
# gate page drift from the spine it is supposed to be testing.
docs/3d/p1/bundle.js

