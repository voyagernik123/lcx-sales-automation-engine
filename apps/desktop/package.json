{
  "name": "@lcx/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "LCX TERMINAL — the native macOS shell for LCX ONE (Tauri v2).",
  "scripts": {
    "dev": "node scripts/with-cargo.mjs tauri dev",
    "build": "node scripts/with-cargo.mjs tauri build",
    "build:dmg": "node scripts/with-cargo.mjs tauri build --bundles app,dmg",
    "build-gate": "node scripts/build-gate.mjs",
    "test": "vitest run scripts",
    "tauri": "node scripts/with-cargo.mjs tauri",
    "release": "node scripts/publish-release.mjs",
    "release:dry": "node scripts/publish-release.mjs --dry-run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-window-state": "^2",
    "@tauri-apps/plugin-os": "^2"
  }
}
