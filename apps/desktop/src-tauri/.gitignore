# Rust build output — multi-GB, machine-specific.
/target

# Tauri-generated ACL schemas — regenerated on every build from
# tauri.conf.json + capabilities/, so they are derived, not source.
/gen/schemas

# Per-command allow-/deny- permissions, written by tauri-build from the command
# list in build.rs on every build. The files say "DO NOT EDIT" in their own first
# line; build.rs is the source, these are the output. The hand-written
# permissions/lcxos-desk.toml beside this directory IS source and is tracked.
/permissions/autogenerated

# Signed bundles are release artifacts, never source.
*.dmg
*.app.tar.gz
*.sig
