# apps/web — Vite SPA

VITE_APP_TITLE=LCX Sales Automation Engine

# Leave empty in local dev to use Vite proxy (/api → http://127.0.0.1:8787)
# In production Pages, set to full API origin e.g. https://api.example.com
VITE_API_URL=

# Operator key for protected API calls (must match apps/api OPERATOR_API_KEY)
VITE_API_KEY=dev-operator-key-change-me

# Supabase "Sign in with Google" — leave empty to keep the dev picker as the
# only login option
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Dev proxy target (optional override)
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
