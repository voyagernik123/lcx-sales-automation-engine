# apps/api — copy to .env for local development

PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Postgres (docker compose defaults)
DATABASE_URL=postgresql://lcx:lcx_dev_password@localhost:5432/lcx_sales

# Set true only if you intentionally run without Postgres (health returns db: "skipped")
ALLOW_DB_SKIP=false

# Operator auth v1 — send as Authorization: Bearer <key> or X-API-Key: <key>
OPERATOR_API_KEY=dev-operator-key-change-me

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://lcx-sales-automation-engine.pages.dev
