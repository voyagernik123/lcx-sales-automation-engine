{
  "//": "esbuild strips types rather than checking them, so a green build.mjs says only that this file parses. Generated so `npm run type-check:3d` covers every harness by glob.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "@lcx/gl": [
        "../../../packages/gl/src/index.ts"
      ],
      "@lcx/shared": [
        "../../../packages/shared/src/index.ts"
      ],
      "@/*": [
        "../../../apps/web/src/*"
      ]
    }
  },
  "include": [
    "entry.ts"
  ]
}
