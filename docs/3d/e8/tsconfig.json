{
  "//": "esbuild bundles TypeScript by STRIPPING types; it does not verify them, so build.mjs going green says nothing about whether this file is sound. Generated so `npm run type-check:3d` covers every harness rather than only p1 \u2014 six of them were checked by nothing at all.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "@lcx/gl": [
        "../../../packages/gl/src/index.ts"
      ],
      "@lcx/shared": [
        "../../../packages/shared/src/index.ts"
      ],
      "@/*": [
        "../../../apps/web/src/*"
      ]
    }
  },
  "include": [
    "entry.ts"
  ]
}
